{
    "ignored": [
        { "pattern": "^docs(/.*)?$", "reason": "tested by the Quarkus Documentation CI workflow" }
    ],
    "rules": [
        { "pattern": "^integration-tests/(maven|devmode)(/.*)?$", "group": "maven" },
        { "pattern": "^integration-tests/gradle(/.*)?$", "group": "gradle" },
        { "pattern": "^(devtools|integration-tests/devtools)(/.*)?$", "group": "devtools" },
        { "pattern": "^integration-tests/kubernetes(/.*)?$", "group": "kubernetes" },
        { "pattern": "^tcks(/.*)?$", "group": "tcks" },
        { "pattern": "^integration-tests(/[a-l].*)?$", "group": "jvm-integration-1" },
        { "pattern": "^integration-tests/.+$", "group": "jvm-integration-2" },
        { "pattern": "^(independent-projects|core|test-framework)(/.*)?$", "group": "jvm-core-infra" },
        {
            "modules": [
                "extensions/devui/deployment",
                "extensions/flyway/deployment",
                "extensions/grpc/deployment",
                "extensions/hibernate-orm/deployment",
                "extensions/hibernate-reactive/deployment",
                "extensions/micrometer/deployment",
                "extensions/mongodb-client/deployment",
                "extensions/oidc/deployment",
                "extensions/oidc-client/deployment",
                "extensions/oidc-client-graphql/deployment",
                "extensions/opentelemetry/deployment",
                "extensions/panache/hibernate-orm-rest-data-panache/deployment",
                "extensions/qute/deployment",
                "extensions/reactive-oracle-client/deployment",
                "extensions/resteasy-classic/resteasy/deployment",
                "extensions/resteasy-reactive/rest/deployment",
                "extensions/resteasy-reactive/rest-client/deployment",
                "extensions/smallrye-graphql/deployment",
                "extensions/smallrye-reactive-messaging/deployment",
                "extensions/vertx-http/deployment",
                "extensions/websockets-next/deployment"
            ],
            "group": "jvm-heavy"
        },
        { "pattern": "^.*$", "group": "jvm-main" }
    ],
    "modified-modules": {
        "group": "jvm-modified",
        "eligible-groups": [ "jvm-heavy", "jvm-main" ],
        "max-modules": 5
    },
    "matrix-categories": {
        "Runtime": [
            { "group": "jvm-core-infra", "name-qualifier": "Core infra", "gate": true },
            { "group": "jvm-modified", "name-qualifier": "Modified modules", "gate": true, "entries": [ "JVM Tests - JDK 21" ] },
            { "group": "jvm-heavy", "name-qualifier": "Heavy modules" },
            { "group": "jvm-main", "name-qualifier": "Other modules" }
        ],
        "Integration": [
            { "group": "jvm-integration-1", "name-qualifier": "A-L" },
            { "group": "jvm-integration-2", "name-qualifier": "M-Z" }
        ]
    }
}
