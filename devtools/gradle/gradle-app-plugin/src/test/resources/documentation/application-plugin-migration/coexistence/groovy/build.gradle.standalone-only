import io.quarkus.gradle.application.tasks.QuarkusApplicationDevTask
import org.gradle.api.tasks.testing.Test

// tag::standalone-only-final[]
plugins {
    id 'io.quarkus.application'
}

group = 'org.acme'
version = '1.0.0'

def quarkusPlatformVersion = providers.gradleProperty('quarkusPlatformVersion').get()
def quarkusPlatformGroupId = providers.gradleProperty('quarkusPlatformGroupId')
    .orElse('io.quarkus.platform').get()

dependencies {
    implementation enforcedPlatform("${quarkusPlatformGroupId}:quarkus-bom:${quarkusPlatformVersion}")
    implementation 'io.quarkus:quarkus-rest'
    quarkusDev 'io.quarkus:quarkus-jdbc-h2'

    testImplementation 'io.quarkus:quarkus-junit'
    testImplementation 'io.rest-assured:rest-assured'
}

quarkusApplication {
    builds {
        fastJar('service') {
            outputName.set('acme-service')
            participatesInAssemble.set(true)
        }
        nativeExecutable('native')
    }
    tests {
        allGradleTestTasks()
    }
}
// end::standalone-only-final[]

def quarkusDevConfiguration = configurations.named('quarkusDev')
def standaloneDev = tasks.named('quarkusApplicationDev', QuarkusApplicationDevTask)
def functionalTest = tasks.register('functionalTest', Test)

tasks.register('verifyStandaloneOwnership') {
    doLast {
        assert !quarkusDevConfiguration.get().canBeResolved
        assert !quarkusDevConfiguration.get().canBeConsumed
        assert !standaloneDev.get().legacyTestsOwned.get()
        assert tasks.findByName('quarkusBuild') == null
        assert tasks.findByName('quarkusServiceBuild') != null
        assert tasks.findByName('quarkusNativeNativeTest') != null
        assert tasks.findByName('quarkusGenerateCode') == null
        assert tasks.findByName('quarkusApplicationGenerateCode') != null
        assert functionalTest.get().taskDependencies.getDependencies(functionalTest.get())*.name
            .contains('quarkusApplicationTestModel')
        def assemble = tasks.named('assemble').get()
        def assembleDependencies = assemble.taskDependencies.getDependencies(assemble)*.name as Set
        assert assembleDependencies.contains('quarkusServiceBuild')
        assert !assembleDependencies.contains('quarkusBuild')
    }
}
