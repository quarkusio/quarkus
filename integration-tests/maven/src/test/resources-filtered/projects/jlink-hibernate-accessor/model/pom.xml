<?xml version="1.0" encoding="UTF-8"?>
<project>
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.acme</groupId>
        <artifactId>jlink-hibernate-accessor</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>jlink-accessor-model</artifactId>
    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-accessor</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- The CLASS-retained registration annotations do not require a runtime module dependency. -->
                    <useModulePath>false</useModulePath>
                    <compilerArgs>
                        <arg>--add-reads</arg>
                        <arg>accessor.model=ALL-UNNAMED</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
