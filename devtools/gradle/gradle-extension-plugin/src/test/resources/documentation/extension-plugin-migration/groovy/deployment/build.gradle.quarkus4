// Source: {{source}}
// tag::four-x-deployment-project[]
plugins {
    id 'java-library'
    id 'io.quarkus.extension.deployment'
}
// end::four-x-deployment-project[]

group = 'org.acme'
version = '1.0.0'

// tag::deployment-runtime-dependency[]
dependencies {
    implementation enforcedPlatform("io.quarkus:quarkus-bom:${quarkusPlatformVersion}")
    implementation project(':runtime')
    implementation 'io.quarkus:quarkus-arc-deployment'
}
// end::deployment-runtime-dependency[]

dependencies {
    testImplementation 'org.junit.jupiter:junit-jupiter-api:5.10.3'
    testRuntimeOnly 'org.junit.jupiter:junit-jupiter-engine:5.10.3'
}
